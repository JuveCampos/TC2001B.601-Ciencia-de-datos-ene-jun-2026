# NAS en: edad, ingreso_mensual y score_desempeño
bd_plot %>%
mutate(is.na.ingreso_mensual = is.na(ingreso_mensual))
# NAS en: edad, ingreso_mensual y score_desempeño
bd_plot %>%
mutate(is.na.ingreso_mensual = ifelse(is.na(ingreso_mensual), yes = "Tiene NA", no = "Con dato"))
# NAS en: edad, ingreso_mensual y score_desempeño
bd_plot %>%
mutate(is.na.ingreso_mensual = ifelse(is.na(ingreso_mensual),
yes = "Tiene NA",
no = "Con dato")) %>%
group_by(is.na.ingreso_mensual) %>%
summarise(prom_edad = mean(edad, na.rm = T))
# NAS en: edad, ingreso_mensual y score_desempeño
