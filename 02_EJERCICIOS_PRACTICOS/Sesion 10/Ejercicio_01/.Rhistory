# 4. Detecte las variables numéricas. Genere una tabla nueva con esas variables. Grafique su distribución usando geom_density y un arreglo de facetas.
empleados %>%
select(is.numeric(.))
# 4. Detecte las variables numéricas. Genere una tabla nueva con esas variables. Grafique su distribución usando geom_density y un arreglo de facetas.
empleados %>%
select(sapply(is.numeric(.)))
empleados
vector_tipos
empleados %>%
select(vector_tipos == "numeric")
# 4. Detecte las variables numéricas. Genere una tabla nueva con esas variables. Grafique su distribución usando geom_density y un arreglo de facetas.
empleados %>%
select(which(vector_tipos == "numeric"))
# 4. Detecte las variables numéricas. Genere una tabla nueva con esas variables. Grafique su distribución usando geom_density y un arreglo de facetas.
tabla_solo_numeros <- empleados %>%
select(which(vector_tipos == "numeric"))
# 4. Detecte las variables numéricas. Genere una tabla nueva con esas variables. Grafique su distribución usando geom_density y un arreglo de facetas.
bd <- tabla_solo_numeros <- empleados %>%
select(which(vector_tipos == "numeric"))
bd
# 4. Detecte las variables numéricas. Genere una tabla nueva con esas variables. Grafique su distribución usando geom_density y un arreglo de facetas.
bd_plot <- tabla_solo_numeros <- empleados %>%
select(which(vector_tipos == "numeric"))
bd_plot
bd_plot %>%
pivot_longer(cols = 2:ncol(.))
bd_plot %>%
pivot_longer(cols = 2:ncol(.)) %>%
ggplot(aes(x = name, y = value)) +
geom_density()
bd_plot %>%
pivot_longer(cols = 2:ncol(.)) %>%
ggplot(aes(x = name, y = value)) +
geom_density() +
facet_wrap(~name)
bd_plot %>%
pivot_longer(cols = 2:ncol(.)) %>%
ggplot(aes(x = value)) +
geom_density() +
facet_wrap(~name)
bd_plot %>%
pivot_longer(cols = 2:ncol(.)) %>%
ggplot(aes(x = value)) +
geom_density() +
facet_wrap(~name, scales = "free")
bd_plot %>%
pivot_longer(cols = 2:ncol(.)) %>%
ggplot(aes(x = value)) +
geom_boxplot() +
facet_wrap(~name, scales = "free")
library(plotly)
bd_plot %>%
pivot_longer(cols = 2:ncol(.)) %>%
ggplot(aes(x = value)) +
geom_boxplot() +
facet_wrap(~name, scales = "free")
plt_2 <- bd_plot %>%
pivot_longer(cols = 2:ncol(.)) %>%
ggplot(aes(x = value)) +
geom_boxplot() +
facet_wrap(~name, scales = "free")
ggplotly(plt_2)
ggplotly(plt_2)
plt_2
plt_2
plt_2
plt_2
