empleados_ingreso_imputado <- empleados_na %>%
mutate(ingreso_mensual_imputado = ifelse(is.na(ingreso_mensual),
yes = median(ingreso_mensual, na.rm = TRUE),
no = ingreso_mensual))
empleados_ingreso_imputado <- empleados_na %>%
mutate(ingreso_mensual_imputado = ifelse(is.na(ingreso_mensual),
yes = median(ingreso_mensual, na.rm = TRUE),
no = ingreso_mensual)) %>%
select(id, ingreso_mensual, ingreso_mensual_imputado)
empleados_ingreso_imputado <- empleados_na %>%
mutate(ingreso_mensual_imputado = ifelse(is.na(ingreso_mensual),
yes = median(ingreso_mensual, na.rm = TRUE),
no = ingreso_mensual)) %>%
select(id, ingreso_mensual, ingreso_mensual_imputado)
