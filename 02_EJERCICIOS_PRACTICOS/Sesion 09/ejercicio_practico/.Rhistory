Saludos <- function(tiempo = "mañana"){
if(tiempo == "mañana"){
saludo <- "Buenos días"
}else if (tiempo == "noche"){
saludo <- "Buenas noches"
}else{
saludo <- "Hola"
}
return(saludo)
}
Saludos()
Saludos(tiempo = "noche")
Saludos(tiempo = "tared")
