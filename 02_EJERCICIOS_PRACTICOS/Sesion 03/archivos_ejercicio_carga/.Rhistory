c2 = c("Juan", "Pedro", "María", "Alejandra", "Patricia", "Pablo"),
c3 = c("H", "H", "M", "M", "M", "H"),
c4 = c(100, 100, 90, 80, 90, 100))
library(tibble)
tabla <- tibble(id = c(1,2,3,4,5,6),
nombre = c("Juan", "Pedro", "María", "Alejandra", "Patricia", "Pablo"),
sexo = c("H", "H", "M", "M", "M", "H"),
calif = c(100, 100, 90, 80, 90, 100))
tabla
tabla$calif
tabla[,4]
tabla[,"calif"]
tabla$calif
tabla$calif
mean(tabla[,4])
mean(tabla[,4])
mean(tabla[,4] %>% pull())
tabla[,"calif"]
