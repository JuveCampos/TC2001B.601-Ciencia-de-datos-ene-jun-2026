gen_estadistica <- function(variable, nombre_variable = ""){
media <- mean(variable)
sd_var <- sd(variable)
mediana <- median(variable)
q3 <- quantile(variable, 0.75)
q1 <- quantile(variable, 0.25)
iqr <- q3-q1
}
gen_estadistica <- function(variable, nombre_variable = ""){
media <- mean(variable)
sd_var <- sd(variable)
mediana <- median(variable)
q3 <- quantile(variable, 0.75)
q1 <- quantile(variable, 0.25)
iqr <- q3-q1
return(c(media, sd_var, mediana, iqr))
}
gen_estadistica(clima$humedad)
