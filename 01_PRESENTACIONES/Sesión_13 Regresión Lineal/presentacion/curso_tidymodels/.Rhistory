prop = 0.70,
strata = selling_price)
library(tidymodels)
# Create a data split object
home_split <- initial_split(home_sales,
prop = 0.70,
strata = selling_price)
library(tidymodels)
home_sales <- readRDS("home_sales.rds")
# Create a data split object
home_split <- initial_split(home_sales,
prop = 0.7,
strata = selling_price)
# Create the training data
home_training <- home_split %>%
training()
# Create the test data
home_test <- home_split %>%
testing()
# Check number of rows in each dataset
nrow(home_training)
nrow(home_test)
# Distribution of selling_price in training data
home_training %>%
summarize(min_sell_price = min(selling_price),
max_sell_price = max(selling_price),
mean_sell_price = mean(selling_price),
sd_sell_price = sd(selling_price))
# Distribution of selling_price in test data
home_test %>%
summarize(min_sell_price = min(selling_price),
max_sell_price = max(selling_price),
mean_sell_price = mean(selling_price),
sd_sell_price = sd(selling_price))
# Initialize a linear regression object, linear_model
linear_model <- linear_reg() %>%
# Set the model engine
set_engine('lm') %>%
# Set the model mode
set_mode('regression')
# Fit the model using the training data
lm_fit <- linear_model %>%
fit(selling_price ~ home_age+sqft_living,
data = home_training)
# Print lm_fit to view model information
lm_fit
tidy(lm_fit)
# Predict selling_price
home_predictions <- predict(lm_fit,
new_data = home_test)
# View predicted selling prices
home_predictions
# Combine test data with predictions
home_test_results <- home_test %>%
select(selling_price, home_age, sqft_living) %>%
bind_cols(home_predictions)
# View results
home_test_results
# Cargar el ecosistema tidymodels (incluye parsnip, rsample, yardstick, etc.)
library(tidymodels)
# Cargar los datos de ventas de viviendas desde archivo RDS
home_sales <- readRDS("home_sales.rds")
# Crear un objeto de división de datos con rsample::initial_split()
# - prop = 0.7: 70% de los datos se asignan a entrenamiento, 30% a prueba
# - strata = selling_price: estratificación por la variable resultado para
#   asegurar que ambas particiones tengan una distribución similar de precios
home_split <- initial_split(home_sales,
prop = 0.7,
strata = selling_price)
# Extraer el conjunto de entrenamiento a partir del objeto de división
home_training <- home_split %>%
training()
# Extraer el conjunto de prueba a partir del objeto de división
home_test <- home_split %>%
testing()
# Verificar el número de observaciones en cada conjunto
nrow(home_training)
nrow(home_test)
# Calcular estadísticas descriptivas del precio de venta en los datos de
# entrenamiento para confirmar que la estratificación funcionó correctamente
home_training %>%
summarize(min_sell_price = min(selling_price),
max_sell_price = max(selling_price),
mean_sell_price = mean(selling_price),
sd_sell_price = sd(selling_price))
# Calcular las mismas estadísticas en los datos de prueba
# Los valores mínimos, máximos, medias y desviaciones deben ser similares
home_test %>%
summarize(min_sell_price = min(selling_price),
max_sell_price = max(selling_price),
mean_sell_price = mean(selling_price),
sd_sell_price = sd(selling_price))
# Definir un modelo de regresión lineal con parsnip
# - linear_reg(): especifica el tipo de modelo
# - set_engine("lm"): usa el motor stats::lm de R base
# - set_mode("regression"): indica que es un problema de regresión (no clasificación)
linear_model <- linear_reg() %>%
set_engine("lm") %>%
set_mode("regression")
linear_model
# Imprimir el objeto ajustado para ver información general del modelo
lm_fit
# Usar tidy() de broom para obtener una tabla limpia con los coeficientes
# estimados: intercepto, pendiente para home_age y pendiente para sqft_living
tidy(lm_fit)
# Usar el modelo entrenado para predecir los precios de venta en los datos
# de prueba (datos que el modelo nunca vio durante el entrenamiento)
home_predictions <- predict(lm_fit,
new_data = home_test)
# Ver las predicciones generadas (columna .pred)
home_predictions
# Combinar los datos de prueba originales con las predicciones para facilitar
# la evaluación: se seleccionan las columnas relevantes y se unen con bind_cols
home_test_results <- home_test %>%
select(selling_price, home_age, sqft_living) %>%
bind_cols(home_predictions)
# Ver el resultado combinado: precio real, predictores y precio predicho
home_test_results
# Calcular el RMSE (Root Mean Squared Error / Raíz del Error Cuadrático Medio)
# - Mide el error promedio de predicción en las mismas unidades que la variable
#   resultado (dólares en este caso)
# - Valores más cercanos a 0 indican mejor rendimiento
home_test_results %>%
rmse(truth = selling_price, estimate = .pred)
# Calcular el R² (coeficiente de determinación)
# - Proporción de la varianza de la variable resultado explicada por el modelo
# - Rango de 0 a 1: 0 = el modelo no explica nada, 1 = explicación perfecta
home_test_results %>%
rsq(truth = selling_price, estimate = .pred)
# Crear un diagrama de dispersión con los valores reales en el eje X y los
# predichos en el eje Y. La línea de referencia (y = x) representa predicciones
# perfectas. Los puntos cerca de la línea indican buen rendimiento.
# - geom_abline(): línea de referencia diagonal (intercept = 0, slope = 1)
# - coord_obs_pred(): asegura que ambos ejes tengan la misma escala
ggplot(home_test_results, aes(x = selling_price, y = .pred)) +
geom_point(alpha = 0.5) +
geom_abline(color = "blue", linetype = 2) +
coord_obs_pred() +
labs(x = "Precio de Venta Real de la Vivienda",
y = "Precio de Venta Predicho")
# Redefinir el modelo de regresión lineal
linear_model <- linear_reg() %>%
set_engine("lm") %>%
set_mode("regression")
# Ajustar y evaluar el modelo en un solo paso
# Fórmula: selling_price ~ .  (usa TODAS las variables predictoras disponibles)
linear_fit <- linear_model %>%
last_fit(selling_price ~ ., split = home_split)
# Extraer las predicciones generadas por last_fit()
predictions_df <- linear_fit %>%
collect_predictions()
# Ver las predicciones
predictions_df
# Crear el gráfico de R² con el modelo que usa todos los predictores
ggplot(predictions_df, aes(x = selling_price, y = .pred)) +
geom_point(alpha = 0.5) +
geom_abline(color = "blue", linetype = 2) +
coord_obs_pred() +
labs(x = "Precio de Venta Real de la Vivienda",
y = "Precio de Venta Predicho")
# Crear el gráfico de R² con el modelo que usa todos los predictores
ggplot(predictions_df, aes(x = selling_price, y = .pred)) +
geom_point(alpha = 0.5) +
geom_abline(color = "blue", linetype = 2) +
coord_obs_pred() +
labs(x = "Precio de Venta Real de la Vivienda",
y = "Precio de Venta Predicho")
# Cargar el ecosistema tidymodels (incluye parsnip, rsample, yardstick, etc.)
library(tidymodels)
# Cargar los datos de ventas de viviendas desde archivo RDS
home_sales <- readRDS("home_sales.rds")
# Crear un objeto de división de datos con rsample::initial_split()
# - prop = 0.7: 70% de los datos se asignan a entrenamiento, 30% a prueba
# - strata = selling_price: estratificación por la variable resultado para
#   asegurar que ambas particiones tengan una distribución similar de precios
home_split <- initial_split(home_sales,
prop = 0.7,
strata = selling_price)
home_split
# Extraer el conjunto de entrenamiento a partir del objeto de división
home_training <- home_split %>%
training()
# Extraer el conjunto de prueba a partir del objeto de división
home_test <- home_split %>%
testing()
# Verificar el número de observaciones en cada conjunto
nrow(home_training)
nrow(home_test)
# Calcular estadísticas descriptivas del precio de venta en los datos de
# entrenamiento para confirmar que la estratificación funcionó correctamente
home_training %>%
summarize(min_sell_price = min(selling_price),
max_sell_price = max(selling_price),
mean_sell_price = mean(selling_price),
sd_sell_price = sd(selling_price))
# Calcular las mismas estadísticas en los datos de prueba
# Los valores mínimos, máximos, medias y desviaciones deben ser similares
home_test %>%
summarize(min_sell_price = min(selling_price),
max_sell_price = max(selling_price),
mean_sell_price = mean(selling_price),
sd_sell_price = sd(selling_price))
# Definir un modelo de regresión lineal con parsnip
# - linear_reg(): especifica el tipo de modelo
# - set_engine("lm"): usa el motor stats::lm de R base
# - set_mode("regression"): indica que es un problema de regresión (no clasificación)
linear_model <- linear_reg() %>%
set_engine("lm") %>%
set_mode("regression")
# Ajustar (entrenar) el modelo usando los datos de entrenamiento
# Fórmula: selling_price ~ home_age + sqft_living
#   - selling_price: variable resultado (precio de venta)
#   - home_age: antigüedad de la vivienda (años)
#   - sqft_living: metros cuadrados de construcción (en pies²)
lm_fit <- linear_model %>%
fit(selling_price ~ home_age + sqft_living,
data = home_training)
# Imprimir el objeto ajustado para ver información general del modelo
lm_fit
# Usar tidy() de broom para obtener una tabla limpia con los coeficientes
# estimados: intercepto, pendiente para home_age y pendiente para sqft_living
tidy(lm_fit)
# Usar el modelo entrenado para predecir los precios de venta en los datos
# de prueba (datos que el modelo nunca vio durante el entrenamiento)
home_predictions <- predict(lm_fit,
new_data = home_test)
# Ver las predicciones generadas (columna .pred)
home_predictions
# Combinar los datos de prueba originales con las predicciones para facilitar
# la evaluación: se seleccionan las columnas relevantes y se unen con bind_cols
home_test_results <- home_test %>%
select(selling_price, home_age, sqft_living) %>%
bind_cols(home_predictions)
home_test %>%
select(selling_price, home_age, sqft_living)
home_predictions
# Combinar los datos de prueba originales con las predicciones para facilitar
# la evaluación: se seleccionan las columnas relevantes y se unen con bind_cols
home_test_results <- home_test %>%
select(selling_price, home_age, sqft_living) %>%
bind_cols(home_predictions)
# Ver el resultado combinado: precio real, predictores y precio predicho
home_test_results
# Calcular el RMSE (Root Mean Squared Error / Raíz del Error Cuadrático Medio)
# - Mide el error promedio de predicción en las mismas unidades que la variable
#   resultado (dólares en este caso)
# - Valores más cercanos a 0 indican mejor rendimiento
home_test_results %>%
rmse(truth = selling_price, estimate = .pred)
# Calcular el R² (coeficiente de determinación)
# - Proporción de la varianza de la variable resultado explicada por el modelo
# - Rango de 0 a 1: 0 = el modelo no explica nada, 1 = explicación perfecta
home_test_results %>%
rsq(truth = selling_price, estimate = .pred)
# Crear un diagrama de dispersión con los valores reales en el eje X y los
# predichos en el eje Y. La línea de referencia (y = x) representa predicciones
# perfectas. Los puntos cerca de la línea indican buen rendimiento.
# - geom_abline(): línea de referencia diagonal (intercept = 0, slope = 1)
# - coord_obs_pred(): asegura que ambos ejes tengan la misma escala
ggplot(home_test_results, aes(x = selling_price, y = .pred)) +
geom_point(alpha = 0.5) +
geom_abline(color = "blue", linetype = 2) +
coord_obs_pred() +
labs(x = "Precio de Venta Real de la Vivienda",
y = "Precio de Venta Predicho")
# Crear un diagrama de dispersión con los valores reales en el eje X y los
# predichos en el eje Y. La línea de referencia (y = x) representa predicciones
