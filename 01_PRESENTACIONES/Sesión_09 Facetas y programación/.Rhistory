library(tidyverse)
set.seed(42)
ciudades <- c(
"Monterrey", "Guadalajara", "CDMX",
"Merida", "Puebla", "Tijuana"
)
anios <- 2018:2025
trimestres <- 1:4
# Generamos todas las combinaciones ciudad-anio-trimestre
datos_ventas <- expand.grid(
ciudad = ciudades,
anio = anios,
trimestre = trimestres,
stringsAsFactors = FALSE
) %>%
as_tibble() %>%
arrange(ciudad, anio, trimestre)
# Asignamos ventas base por ciudad (miles de pesos)
ventas_base <- c(
"Monterrey" = 800, "Guadalajara" = 750, "CDMX" = 1200,
"Merida" = 500, "Puebla" = 600, "Tijuana" = 650
)
# Simulamos ventas con tendencia creciente y estacionalidad
datos_ventas <- datos_ventas %>%
mutate(
# Indice temporal para tendencia
t = (anio - 2018) * 4 + trimestre,
# Ventas con tendencia + estacionalidad + ruido
ventas = ventas_base[ciudad] +
t * 15 +
ifelse(trimestre == 4, 200, 0) +
ifelse(trimestre == 1, -100, 0) +
rnorm(n(), mean = 0, sd = 80),
ventas = round(ventas, 1)
)
# Verificamos la estructura
print(head(datos_ventas, 10))
ventas_altas <- datos_ventas %>%
filter(ventas > 1000)
print(paste(
"Registros con ventas > 1000:",
nrow(ventas_altas)
))
# Ventas del ultimo anio disponible
ventas_2025 <- datos_ventas %>%
filter(anio == 2025)
ventas_2025
norte_q4_alto <- datos_ventas %>%
filter(
ciudad %in% c("Monterrey", "Tijuana") &
trimestre == 4 &
ventas >= 1000
)
print(paste(
"Registros norte, Q4, ventas >= 1000:",
nrow(norte_q4_alto)
))
# Todas las ciudades EXCEPTO CDMX y Guadalajara
ciudades_pequenas <- datos_ventas %>%
filter(
!(ciudad %in% c("CDMX", "Guadalajara"))
)
ciudades_pequenas
datos_ventas <- datos_ventas %>%
mutate(
desempeno = case_when(
ventas >= 1200 ~ "Excelente",
ventas >= 900  ~ "Bueno",
ventas >= 600  ~ "Regular",
TRUE           ~ "Bajo"
)
)
# Conteo de desempeno por categoria
datos_ventas %>%
count(desempeno) %>%
print()
clasificar_region <- function(ciudad) {
# Valida que el argumento sea texto
stopifnot(is.character(ciudad))
if (ciudad %in% c("Monterrey", "Tijuana")) {
return("Norte")
} else if (ciudad %in% c("CDMX", "Puebla")) {
return("Centro")
} else if (ciudad == "Guadalajara") {
return("Occidente")
} else if (ciudad == "Merida") {
return("Sureste")
} else {
return("Otra")
}
}
# Aplicamos la funcion con sapply (vectorizacion via apply)
datos_ventas <- datos_ventas %>%
mutate(
region = sapply(ciudad, clasificar_region)
)
print("--- Resumen de ventas por ciudad ---")
for (cd in ciudades) {
ventas_cd <- datos_ventas %>%
filter(ciudad == cd) %>%
pull(ventas)
promedio <- round(mean(ventas_cd), 1)
maximo <- max(ventas_cd)
# Condicional dentro del bucle
if (promedio > 900) {
etiqueta <- " [ALTO]"
} else {
etiqueta <- ""
}
print(paste0(
cd, ": promedio = ", promedio,
", max = ", maximo, etiqueta
))
}
generar_grafica_ciudad <- function(datos,
ciudad_elegida,
guardar = FALSE) {
# Validaciones
stopifnot(is.data.frame(datos))
stopifnot(ciudad_elegida %in% datos$ciudad)
datos_filtrados <- datos %>%
filter(ciudad == ciudad_elegida)
grafica <- ggplot(
datos_filtrados,
aes(x = t, y = ventas)
) +
geom_line(
color = "#2C3E50",
linewidth = 1
) +
geom_point(
aes(color = desempeno),
size = 2.5
) +
scale_color_manual(
values = c(
"Excelente" = "#27AE60",
"Bueno" = "#3498DB",
"Regular" = "#F39C12",
"Bajo" = "#E74C3C"
)
) +
labs(
title = paste("Ventas trimestrales:", ciudad_elegida),
subtitle = "2018-2025 (miles de pesos)",
x = "Trimestre (indice)",
y = "Ventas (miles MXN)",
color = "Desempeno"
) +
theme_minimal(base_size = 13)
if (guardar) {
nombre_archivo <- paste0(
"grafica_", tolower(ciudad_elegida), ".png"
)
ggsave(nombre_archivo, grafica,
width = 8, height = 5)
print(paste("Guardada:", nombre_archivo))
}
return(grafica)
}
# Ejemplo: generar grafica individual para Monterrey
grafica_mty <- generar_grafica_ciudad(
datos_ventas, "Monterrey"
)
print(grafica_mty)
# Usando un bucle for para generar TODAS las graficas
# (alternativa a facet_wrap cuando se necesitan archivos
# separados por ciudad)
for (cd in ciudades) {
g <- generar_grafica_ciudad(
datos_ventas, cd, guardar = FALSE
)
print(g)
}
grafica_espagueti <- ggplot(
datos_ventas,
aes(
x = t, y = ventas,
color = ciudad
)
) +
geom_line(linewidth = 0.8) +
geom_point(size = 1.2, alpha = 0.6) +
scale_color_brewer(palette = "Set2") +
labs(
title = "Ventas trimestrales por ciudad",
subtitle = "Todas las ciudades | 2018-2025",
x = "Trimestre (indice)",
y = "Ventas (miles MXN)",
color = "Ciudad"
) +
theme_minimal(base_size = 13)
print(grafica_espagueti)
grafica_facetas <- ggplot(
datos_ventas,
aes(x = t, y = ventas, color = region)
) +
geom_line(linewidth = 0.8) +
geom_point(size = 1.2) +
facet_wrap(
~ciudad,
ncol = 3,
scales = "free_y"
) +
scale_color_brewer(palette = "Set1") +
labs(
title = "Ventas trimestrales por ciudad",
subtitle = paste(
"2018-2025 | Un panel por ciudad |",
"Escala Y libre"
),
x = "Trimestre (indice)",
y = "Ventas (miles MXN)",
color = "Region"
) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(
angle = 45, hjust = 1
),
strip.text = element_text(face = "bold"),
legend.position = "bottom"
)
print(grafica_facetas)
grafica_por_region <- ggplot(
datos_ventas,
aes(x = t, y = ventas, color = ciudad)
) +
geom_line(linewidth = 0.8) +
geom_point(size = 1) +
facet_wrap(~region, ncol = 2) +
scale_color_brewer(palette = "Dark2") +
labs(
title = "Ventas por region geografica",
subtitle = paste(
"Regiones clasificadas con funcion propia"
),
x = "Trimestre (indice)",
y = "Ventas (miles MXN)",
color = "Ciudad"
) +
theme_minimal(base_size = 12) +
theme(
strip.text = element_text(
face = "bold", size = 12
),
legend.position = "bottom"
)
print(grafica_por_region)
