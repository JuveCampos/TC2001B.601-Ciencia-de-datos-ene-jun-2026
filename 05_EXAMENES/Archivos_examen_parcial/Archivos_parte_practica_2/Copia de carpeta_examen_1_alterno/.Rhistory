datos_ingreso_hogar
datos_ingreso_hogar %>%
left_join(cat_edos)
datos_ingreso_hogar %>%
left_join(cat_edos) %>%
ggplot(aes( x = year, y = valor, color = entidad)) +
geom_line() +
facet_wrap(~entidad)
datos_ingreso_hogar %>%
left_join(cat_edos) %>%
ggplot(aes( x = year, y = valor, color = entidad)) +
geom_line() +
facet_wrap(~entidad) +
theme_minimal(legend.position = "none")
datos_ingreso_hogar %>%
left_join(cat_edos) %>%
ggplot(aes( x = year, y = valor, color = entidad)) +
geom_line() +
facet_wrap(~entidad) +
theme_minimal(legend.position = NULL)
datos_ingreso_hogar %>%
left_join(cat_edos) %>%
ggplot(aes( x = year, y = valor, color = entidad)) +
geom_line() +
facet_wrap(~entidad) +
theme_minimal(legend.position = "none")
datos_ingreso_hogar %>%
left_join(cat_edos) %>%
ggplot(aes( x = year, y = valor, color = entidad)) +
geom_line() +
facet_wrap(~entidad) +
theme(legend.position = "none")
datos_ingreso_hogar %>%
left_join(cat_edos) %>%
ggplot(aes( x = year, y = valor, color = entidad)) +
geom_line() +
facet_wrap(~entidad, scales = "free") +
theme(legend.position = "none")
