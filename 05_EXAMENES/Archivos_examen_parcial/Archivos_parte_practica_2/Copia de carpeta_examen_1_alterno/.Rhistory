library(tidyverse)
library(readxl)
datos_rct <- read_excel("datos_rct_vitamina.xlsx")
datos_rct
datos_rct %>%
group_by(grupo) %>%
summarise(tamanio_grupo = n(),
media_calif_final = mean(calificacion_final),
media_calif_precia = mean(calificacion_previa),
sd_calif_final = sd(calificacion_final),
media_edad = mean(edad),
media_horas_suenio = mean(horas_sueno))
incremento = 7.60 - 7.15
incremento
datos <- read_excel("indicador_1051_ingreso_hogares_pesos_2022.xlsx")
datos_ingreso_hogar <- read_excel("indicador_1051_ingreso_hogares_pesos_2022.xlsx")
datos_ingreso_hogar
datos_ingreso_hogar
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
ggplot(aes(x = year, y = valor))
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
ggplot(aes(x = year, y = valor)) +
geom_col()
datos_ingreso_hogar %>%
filter(year == max(year))
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
ggplot(aes(x = cve_ent, y = valor)) +
geom_col()
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
ggplot(aes(x = cve_ent, y = valor)) +
geom_col() +
coord_flip()
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
ggplot(aes(x = reorder(cve_ent, valor), y = valor)) +
geom_col() +
coord_flip()
cat_edos <- read_csv("cat_edos.csv")
cat_edos
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
left_join(cat_edos) %>%
ggplot(aes(x = reorder(cve_ent, valor), y = valor)) +
geom_col() +
coord_flip()
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
left_join(cat_edos)
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
left_join(cat_edos) %>%
ggplot(aes(x = reorder(entidad_abr_m, valor), y = valor)) +
geom_col() +
coord_flip()
datos_ingreso_hogar %>%
filter(year == max(year)) %>%
left_join(cat_edos) %>%
ggplot(aes(x = reorder(entidad_abr_m, valor), y = valor)) +
geom_col() +
