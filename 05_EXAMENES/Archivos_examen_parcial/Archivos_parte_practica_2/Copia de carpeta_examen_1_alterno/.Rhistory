geom_col() +
coord_flip()
bd %>%
ggplot(aes(x = reorder(sector, cambio_mensual), y = cambio_mensual)) +
geom_col() +
labs(title = "Cambio mensual en el total de\npuestos de trabajo.")
bd %>%
