datos <- tribble(
~presidente, ~periodo,                ~crecimiento, ~color,
"MMH",       "[1982T4 - 1988T2]",     1.4,         "verde oscuro",
"CSG",       "[1988T4 - 1994T2]",    24.8,         "verde oscuro",
"EZPDL",     "[1994T4 - 2000T2]",    20.6,         "verde oscuro",
"VFQ",       "[2000T4 - 2006T2]",    11.6,         "azul claro",
"FCH",       "[2006T4 - 2012T2]",     7.6,         "verde oscuro",
"EPN",       "[2012T4 - 2018T2]",    11.3,         "verde oscuro",
"AMLO",      "[2018T4 - 2024T2]",     4.5,         "café"
)
datos
datos %>%
ggplot(aes(x = presidente, y = crecimiento, fill = color)) +
geom_col()
datos %>%
ggplot(aes(x = reorder(presidente, presidente),
y = crecimiento, fill = color)) +
geom_col()
datos %>%
ggplot(aes(x = presidente,
y = crecimiento, fill = color)) +
geom_col()
datos %>%
mutate(x = str_c(presidente, "\n", periodo))
datos %>%
mutate(x = str_c(presidente, "\n", periodo)) %>%
ggplot(aes(x = x,
y = crecimiento, fill = color)) +
geom_col()
datos2 <- datos %>%
mutate(x = str_c(presidente, "\n", periodo))
datos2
datos2 <- datos %>%
mutate(x = str_c(presidente, "\n", periodo)) %>%
select(etiqueta = x, presidente, periodo, crecimiento, color)
datos2
write_csv(datos2, "crecimiento_presidente.csv")
datos <- data.frame(
id = 1:40,
minutos = c(
35, 3, 42, 30, 33, 48, 150, 37, 31, 44,
36, 28, 40, NA, 34, 2, 38, 45, 32, 180,
29, 41, 35, 33, 47, 25, 37, 43, 34, 39,
NA, 36, 30, 46, 38, 31, 3, 42, 28, 155
)
)
datos
datos
datos
library(tidyverse)
# (2) Explora la variable minutos: calcula la media, mediana, mínimo y máximo. ¿Notas algo raro?
mean(datos$minutos)
median(datos$minutos)
min(datos$minutos)
max(datos$minutos)
is.na(datos$minutos)
sum(is.na(datos$minutos))
mean(datos$minutos, na.rm = T)
# (2) Explora la variable minutos: calcula la media, mediana, mínimo y máximo. ¿Notas algo raro?
mean(datos$minutos, na.rm = T)
median(datos$minutos, na.rm = T)
min(datos$minutos, na.rm = T)
max(datos$minutos, na.rm = T)
sum(is.na(datos$minutos))
datos
datos %>%
mutate(q3 = quantile(minutos, 0.75, na.rm = T))
datos %>%
mutate(q3 = quantile(minutos, 0.75, na.rm = T),
q1 = quantile(minutos, 0.25, na.rm = T),
)
datos %>%
mutate(q3 = quantile(minutos, 0.75, na.rm = T),
q1 = quantile(minutos, 0.25, na.rm = T),
iqr = q3-q1
)
datos %>%
mutate(q3 = quantile(minutos, 0.75, na.rm = T),
q1 = quantile(minutos, 0.25, na.rm = T),
iqr = q3-q1,
lim_sup = q3 + 1.5*iqr
lim_inf = q1 - 1.5*iqr
datos %>%
mutate(q3 = quantile(minutos, 0.75, na.rm = T),
q1 = quantile(minutos, 0.25, na.rm = T),
iqr = q3-q1,
lim_sup = q3 + 1.5*iqr,
lim_inf = q1 - 1.5*iqr
)
datos %>%
mutate(q3 = quantile(minutos, 0.75, na.rm = T),
q1 = quantile(minutos, 0.25, na.rm = T),
iqr = q3-q1,
lim_sup = q3 + 1.5*iqr,
lim_inf = q1 - 1.5*iqr
) %>%
mutate(is.outlier = minutos < lim_inf | minutos > lim_sup)
datos %>%
mutate(q3 = quantile(minutos, 0.75, na.rm = T),
q1 = quantile(minutos, 0.25, na.rm = T),
iqr = q3-q1,
lim_sup = q3 + 1.5*iqr,
lim_inf = q1 - 1.5*iqr
) %>%
mutate(is.outlier = minutos < lim_inf | minutos > lim_sup) %>%
filter(is.outlier)
