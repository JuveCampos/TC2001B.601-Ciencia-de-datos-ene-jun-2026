library(tidyverse)
datos <- data.frame(
id = 1:40,
minutos = c(
35, 3, 42, 30, 33, 48, 150, 37, 31, 44,
36, 28, 40, NA, 34, 2, 38, 45, 32, 180,
29, 41, 35, 33, 47, 25, 37, 43, 34, 39,
NA, 36, 30, 46, 38, 31, 3, 42, 28, 155
)
)
"https://github.com/JuveCampos/TC2001B.601-Ciencia-de-datos-ene-jun-2026/raw/refs/heads/main/05_EXAMENES/preparacion_examen_practico/tiempo_traslado.csv"
datos
write_csv(datos, "tiempo_traslado.csv")
traslado <- read_csv("https://raw.githubusercontent.com/JuveCampos/TC2001B.601-Ciencia-de-datos-ene-jun-2026/refs/heads/main/05_EXAMENES/preparacion_examen_practico/tiempo_traslado.csv")
datos
write_csv(datos, "tiempo_traslado.csv")
# (2) Explora la variable minutos: calcula la media, mediana, mínimo y máximo. ¿Notas algo raro? Recuerda que para hacer calculos ignorando los valores NA hay que utilizar el argumento na.rm que ya viene programado en las funciones básicas de estadística descriptiva.
mean(datos$minutos, na.rm = T)
median(datos$minutos, na.rm = T)
min(datos$minutos, na.rm = T)
max(datos$minutos, na.rm = T)
# (3) Identifica y maneja los valores NA. ¿Cuántos hay? Para ello, puede utilizar la función is.na()
sum(is.na(datos$minutos)) # Hay dos valores NAs.
datos %>%
mutate(q3 = quantile(minutos, 0.75, na.rm = T),
q1 = quantile(minutos, 0.25, na.rm = T),
iqr = q3-q1,
lim_sup = q3 + 1.5*iqr,
lim_inf = q1 - 1.5*iqr
) %>%
mutate(is.outlier = minutos < lim_inf | minutos > lim_sup) %>%
filter(is.outlier)
# (5) Genera un boxplot de la variable minutos.
plt <- datos %>%
ggplot(aes(y = 1, x = minutos)) +
geom_boxplot()
plt
