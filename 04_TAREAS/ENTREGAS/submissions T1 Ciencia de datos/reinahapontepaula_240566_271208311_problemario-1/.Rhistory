width = 10, #guarda la gráfica en la carpeta de la computadora con ese nombre, formato y medidas
height = 8)
library(tidyverse)
library(ggthemes)
cat_edos = read_csv("datos_problemario/cat_edos.csv")
cat_mun = read_csv("datos_problemario/cat_mun.csv")
indicadores_estatales = read_csv("datos_problemario/indicadores_estatales.csv")
indicadores_municipales = read_csv("datos_problemario/indicadores_municipales.csv")
metadatos_estatales = read_csv("datos_problemario/metadatos_estatales.csv")
metadatos_municipales = read_csv("datos_problemario/metadatos_municipales.csv")
# EJERCICIO 1  ------------------------------------------------------------
# ¿Cuáles son los 3 estados con mayor pobreza en 2022?
estados_pobreza_2022 = indicadores_estatales %>%
filter(no == 921) %>%
filter(year == 2022) %>%
filter(cve_ent != "00") #filtramos el indicador y año que nos interesa y eliminamos la entidad con código "00" que en realidad es el promedio nacional
tc1 = left_join(estados_pobreza_2022, cat_edos, by = "cve_ent", "valor") #Creamos tabla conjunta entre la que acabamos de crear y el catálogo de estados mediante columnas en común
tc1 %>%
arrange(-valor) %>%
head(3) #Clasificamos la tabla de acuerdo al valor de mayor a menor y pedimos que nos muestre los top 3 con menor valor
# Los estados más pobres en el 2022 fueron Chiapas, Guerrero y Oaxaca
# EJERCICIO 2 -------------------------------------------------------------
# ¿Cuántos años de diferencia hay entre el estado con mayor y menor esperanza de vida?
estados_vida_2020 = indicadores_estatales %>%
filter(no == 54) %>%
filter(year == 2020) %>%
filter(cve_ent != "00") #filtramos el indicador y año que nos interesa y eliminamos la entidad con código "00" que en realidad es el promedio nacional
tc2 = left_join(estados_vida_2020, cat_edos, by = "cve_ent", "valor")
top_5_ev = tc2 %>%
arrange(-valor) %>%
head(5) #pedimos que de acuerdo a la variable de valor nos muestre los top 5 con mayor valor
bottom_5_ev = tc2%>%
arrange(valor) %>%
head(5) #pedimos que de acuerdo a la variable de valor nos muestre los top 5 con menor valor
72.52025 - 65.18210
#La brecha entre el estado con mayor y menor esperanza de vida es de 7.33815 años
# EJERCICIO 3 -------------------------------------------------------------
# ¿Qué estado tuvo el mayor crecimiento porcentual en adopción de celulares?
tcelulares = indicadores_estatales %>%
filter(no == 98) %>%
filter(year %in% c(2005, 2020)) %>%
filter(cve_ent != "00")
tc3 = left_join(tcelulares, cat_edos, by = "cve_ent", "valor")
pw2005_2020 = tc3 %>%
pivot_wider(names_from = "year",
values_from = "valor") #hacemos que la tabla pase de ser de formato largo a formato ancho indicando que queremos que los años se vuelvan columnas y los valores las filas debajo de estos
tabla_cp = pw2005_2020 %>%
mutate(cambio_absoluto = `2020` - `2005`) %>% #cremoas una columna que nos da la diferencia real (en unidades) entre los dos años
mutate(cambio_porcentual = (((`2020` - `2005`)/`2005`)*100)) #crea una columna que calcula la variación porcentual entre 2005 y el 2020
tabla_cp %>%
arrange(-cambio_porcentual) #ordena la columna de cambio porcentual de mayor a menor
#Durango tuvo el mayor crecimiento en cambio porcentual en la adopción de celulares
# EJERCICIO 4 -------------------------------------------------------------
#¿En qué década se registra el mayor promedio de vehículos por 1000 habitantes?
#¿De cuanto es este promedio para la década con el valor más alto?
decada = indicadores_estatales %>%
filter(no == 156) %>%
filter(cve_ent == "00") %>%
mutate(decadas = floor(year/10)*10) #crea una columna llamada decadas que abarca todos los años que se encuentran en cada decada
vehiculos_decada = decada %>%
group_by(decadas) %>%
summarise(promedio= mean(valor),
desviacion_estandar = sd(valor)) #agrupa las decadas y calcula la desviación estadar y el promedio de cada una
vehiculos_decada %>%
arrange(-promedio) #ordena el promedio de mayor a menor
#En la década del 2020 se registra mayor promedio de vehículos por 1000 habitantes
#El valor del promedio más alto es de 420.11214
# EJERCICIO 5 -------------------------------------------------------------
diabetes = indicadores_estatales %>%
filter(no == 36) %>%
filter(year >= 2000) %>%
filter(year <= 2023) %>% #filtramos para que los años no sean mayores que 2023 ni menores que 2000
filter(cve_ent != "00")
tc4 = left_join(diabetes, cat_edos, by = "cve_ent", "valor")
diabetes_estados = tc4 %>%
filter(entidad %in% c("Chiapas", "Tabasco", "Puebla", "Nuevo León", "Sonora")) #de la tabla conjunta nos quedamos solamente con dichas entidades
grafica_diabetes = diabetes_estados %>%
ggplot(aes(x = year,
y = valor,
group = entidad,
color = entidad #indicamos que queremos que la gráfica sea clasificada por colores y a cada variable (estado) le de un color
))+
theme_minimal()+
theme(plot.title = element_text(face = "bold",
size = 18),
axis.text = element_text(face = "bold",
size = 9),
axis.title.y = element_text( face = "bold.italic"),
axis.title.x = element_text(face = "bold.italic"))+
geom_line()+  #indica que la gráfica secuencial de lineas
labs(title = "Mortalidad por diabetes por cada 100k habitantes",
y = "Muertes por cada 100k habitantes",
x = "Años registrados"
)+
scale_x_continuous(breaks = seq(from =2000, to = 2023, by = 1)) #indica que en el eje x queremos que desde el año 2000 al año 2023 los saltos sean de año en año
# EJERCICIO 6 -------------------------------------------------------------
#¿Cuál fue el estado con la mayor satisfacción por la vida?
vida = indicadores_estatales %>%
filter(no == 569) %>%
filter(year == 2024) %>%
filter(cve_ent != "00")
tc5 = left_join(vida, cat_edos, by = "cve_ent")
grafica_satisfaccion = tc5 %>%
ggplot(aes(x = reorder(entidad_abr_m, valor), #ordena las barras de acuerdo al valor para que vayan en orden
y = valor,
fill = valor, #colorea las barras de acuerdo a su valor
))+
geom_col()+ #indica que es una gráfica de barras
scale_fill_gradient(low = "lightblue", high = "darkgreen")+ #indica que se colorearan de forma gradiente del valor más alto con darkgreen al más bajo con lightblue
theme_minimal()+
labs(title = "Satisfacción con la calidad de vida",
x = "Entidad federativa",
y = "Valor de satisfacción")+
theme(plot.title = element_text(face = "bold",
size = 19),
axis.title = element_text(face = "bold",
size = 17),
axis.text = element_text(face = "bold"))+
coord_flip()+ #logra que la gráfica cambie de eje, lo que estaba en el eje y pasa al x y viceversa
scale_y_continuous(breaks = seq(from = 0, to = 9, by = 1)) #hace que desde el  hasta el 1 el valor vaya de 1 en 1 para ver la escala más claramente
#El estado con mayor satisfacción de vida fue Chihuahua
# EJERCICIO 7 -------------------------------------------------------------
#¿Qué relación observas entre desarrollo económico y fecundidad adolescente?
pf = indicadores_estatales %>%
filter(no == 1266 | no == 40) %>%
filter(year == 2020) %>%
filter(cve_ent != "00")
tc6 = left_join(pf, cat_edos, by = "cve_ent")
pf_wider = tc6 %>%
pivot_wider(names_from = "no",
values_from = "valor") %>%  #convierte la tabla de formato largo a ancho
rename("PIB_per_cápita" =  `1266`, "Fecundidad_adolescente" =  `40`) #cambia el nombre de las columnas
grafica_pib_fecundidad = pf_wider %>%
ggplot(aes(x = PIB_per_cápita/1e4, #convierte la notación científica a cifras más pequeñas
y = Fecundidad_adolescente,
))+
theme_minimal()+
geom_point(color = "purple2", #lo hace una gráfica de puntos e indica que sean de color morado y de tamaño 3
size = 3)+
labs(title = "Fecundidad adolescente en México en relación con el PIB per cápita",
x = "PIB per cápita entre 10k",
y = "Fecundidad adolescente en porcentaje")+
theme(title = element_text(face = "bold",
size = 15),
axis.title = element_text(face = "bold.italic"),
axis.text = element_text(face = "bold"))+
scale_y_continuous(breaks = seq(from = 40, to = 85, by = 5))+
scale_x_continuous(breaks = seq(from = 0, to = 60, by = 5)) #hace lo mismo de las escalas en los ejes
#Se puede observar que en el rango del PIB per cápita de 100,000 y 250,000 se encuentra el mayor porcentaje de fecundidad adolescente
