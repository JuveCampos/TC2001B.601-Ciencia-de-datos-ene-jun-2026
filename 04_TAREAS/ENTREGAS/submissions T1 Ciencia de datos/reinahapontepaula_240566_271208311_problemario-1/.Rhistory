count(CATEGORIA_3) #contamos cuantas veces se repite cada categoria de aceite
rappi %>%
distinct(ANO_MES) #nos indica cuantas categorias de la columna ANO_MES hay
rappicount %>%
ggplot(aes(x = CATEGORIA_3,
y = n/1e2))+ #convierte la notación científica en un número más pequeño y legible
