size = 18),
plot.subtitle = element_text(face = "italic"),
plot.caption = element_text(face = "italic"),
axis.text = element_text(face = "bold",
size = 9),
axis.title.y = element_text(face = "bold.italic"),
axis.title.x = element_text(face = "bold.italic"))+
geom_line()+
labs(title = "Tabasco, la entidad con mayor mortalidad de diabetes por cada 100k habitantes",
subtitle = "Fuente: Base de datos del Subsistema de Información sobre Nacimientos",
caption = "Paula Reinah Aponte",
y = "Muertes por cada 100k habitantes",
x = "Años registrados"
)+
scale_x_continuous(breaks = seq(from =2000, to = 2023, by = 1))+
scale_y_continuous(breaks = seq(from = 25, to = 175, by = 25))+
scale_color_manual(breaks = c("Chiapas", "Tabasco", "Puebla", "Sonora", "Nuevo León"), #indica el orden de las variables
values = c("yellow4","orange2", "tan4", "slateblue", "violetred")) #les da color de forma manual a cada una de las variables
# EJERCICIO 9 -------------------------------------------------------------
lluvias = indicadores_estatales %>%
filter(no == 950) %>%
filter(year == 2002 | 2024) %>% #filtra todos los años desde el 2002 al 2024
filter(cve_ent != "00")
tc5 = left_join(lluvias, cat_edos, by = "cve_ent")
lluvia_6 = tc5 %>%
filter(entidad %in% c("Tabasco", "Chihuahua", "Jalisco", "Yucatán", "Ciudad de México", "Baja California")) #filtra estas entidades para quedarse solo con ellas
grafica_lluvia = lluvia_6 %>%
ggplot(aes(x = year,
y = valor,
group = entidad,
color = entidad))+
geom_smooth(method = "lm")+ #nos ayuda a que la grafica no solo nos muestre los datos sino también la tendencia
theme_minimal()+
facet_wrap(~entidad, scales = "free_y")+ #hace que cada variable tenga su propia grafica y el eje de la y se adapte a la escala de cada una
labs(title = "Lluvia promedio por entidad",
y = "Valor",
x = "Año")+
theme(plot.title = element_text(face = "bold",
size = 16),
axis.title = element_text(face = "bold"),
axis.text = element_text(face = "bold"))+
theme(legend.position = "none") #elimina la sección donde se especifica cada estado porque ya no es necesario al tenerlo desagregado por estado
# EJERCICIO 10  -----------------------------------------------------------
#¿Los estados más violentos son menos felices?
#Describe en un comentario la relación que observas.
homicidios = indicadores_estatales %>%
filter(no == 173) %>%
filter(cve_ent != "00") %>%
rename("valor_homicidios" = "valor") #cambia el nombre de la columna
svida = indicadores_estatales %>%
filter(no == 569) %>%
filter(cve_ent != "00") %>%
rename("valor_satisfaccion" = "valor") #cambia el nombre de la columna
tc7 = inner_join(homicidios, svida, by = c("cve_ent", "year"))
tc72019 = tc7 %>%
filter(year == 2019)
tc8 = left_join(cat_edos, tc72019, by = "cve_ent")
tc8_limpia = tc8 %>%
filter(cve_ent != "33") %>%
filter(cve_ent != "34") %>%
filter(cve_ent != "99") %>%
filter(cve_ent != "00") #quita todos estos códigos de entidades
grafica_violencia_satisfacción = tc8_limpia %>%
ggplot(aes(x = valor_homicidios,
y = valor_satisfaccion
))+
geom_point(color = "coral1",
size = 5)+
theme_minimal()+
labs(title = "Satisfacción en la calidad de vida en 2019 en relación con los homicidios",
x = "Porcentaje de homicidios",
y = "Nivel de satisfacción")+
theme(plot.title = element_text(size = 15,
face = "bold.italic"),
axis.title = element_text(face = "bold"),
axis.text = element_text(face = "bold"))+
scale_y_continuous(breaks = seq(from = 7.2, to = 9 , by =.1))+
scale_x_continuous(breaks = seq(from = 0, to = 100, by = 10)) #en esta parte ya no explico nada porque realmente todos estos pasos ya se han hecho antes
#No, no necesariamente los estados más violentos son más infelices ya que hay estados con menos porcentaje de homicidios y menor nivel de satisfacción
#La relación que observo es que los estados que tienen entre el 20 y 50 por ciento de homicidios son los que se encuentran puntuados con mayor nivel de satisfacción en su calidad de vida
# EJERCICIO 11 ------------------------------------------------------------
tc9 = left_join(indicadores_estatales, metadatos_estatales, by = "no")
indicadores_salud = tc9 %>%
group_by(indicador, umedida) %>%
summarise(n_registros = n()) #muestra la tabla en resumen con nombre del indicador, unidad de medida y número de registros.
# EJERCICIO 12 ------------------------------------------------------------
fecundidad = indicadores_municipales %>%
filter(`Clave de indicador` == 138) %>%
filter(Municipio %in% c("Apodaca", "Cadereyta Jiménez", "El Carmen", "García", "San Pedro Garza García", "General Escobedo", "Guadalupe", "Juárez", "Monterrey", "Salinas Victoria", "San Nicolás de los Garza", "Santa Catarina", "Santiago")) %>%
filter(Año == 2019) %>%
filter(`Clave de metrópoli` == "19.1.01")
grafica_fecundidad_mty = fecundidad %>%
ggplot(aes(x = Municipio,
y = Valor
))+
geom_col(fill = "deeppink")+ #indica que es barras y las rellena de color
theme_minimal()+
labs(title = "Tasa de fecundidad adolescente en la zona metropolitana de Monterrey en el 2019",
subtitle = "La zona comprende los municipios de: Apodaca, Cadereyta Jiménez, El Carmen, García, San Pedro Garza García, General Escobedo, Guadalupe, Juárez, Monterrey, Salinas Victoria, San Nicolás de los Garza, Santa Catarina y Santiago",
y = "Porcentaje de fecundidad")+
theme(plot.title = element_text(face = "bold",
size = 17),
plot.subtitle = element_text(size = 8),
axis.title = element_text(face = "bold"),
axis.text = element_text(face = "bold"))+
scale_y_continuous(breaks = seq(from = 0, to = 85, by = 5))
# EJERCICIO 13 ------------------------------------------------------------
celulares = indicadores_estatales %>%
filter(no == 98) %>%
filter(cve_ent != "00") %>%
filter(cve_ent != "99") %>%
filter(cve_ent != "33") %>%
filter(cve_ent != "34") %>%
filter(year %in% c(2000, 2005, 2010, 2015, 2020)) #se queda solamente con estos valores de años
tc10 = left_join(celulares, cat_edos, by = "cve_ent")
celulares_ancho = tc10 %>%
pivot_wider(names_from = year, values_from = valor) #crea una tabla en formato ancho
# EJERCICIO 14 ------------------------------------------------------------
celulares_largo = celulares_ancho %>%
pivot_longer(cols = c("2000", "2005", "2010", "2015", "2020"), #regresa la tabla a formato largo indicando que columnas se vuelven filas y con que datos
names_to = "year",
values_to = "valor")
celulares_largo = celulares_largo %>%
mutate(year = as.numeric(year)) #convierte los valores de año a numericos
# EJERCICIO 15 ------------------------------------------------------------
lluvia = indicadores_estatales %>%
filter(no == 950) %>%
filter(cve_ent == "26") #se queda solamente con esta entidad (Sonora)
residuos = indicadores_estatales %>%
filter(no == 564) %>%
filter(cve_ent == "26")
incendios = indicadores_estatales %>%
filter(no == 628) %>%
filter(cve_ent == "26")
ambiental = bind_rows(lluvia, residuos, incendios) #une las 3 tablas diferentes que creamos una abajo de la otra
ambiental = left_join(ambiental, metadatos_estatales, by = "no")
grafica_ambiental = ambiental %>%
ggplot(aes(x = year,
y = valor))+
geom_line(color = "orange3")+
