y = Valor
))+
geom_col(fill = "deeppink")+ #indica que es barras y las rellena de color
theme_minimal()+
labs(title = "Tasa de fecundidad adolescente en la zona metropolitana de Monterrey en el 2019",
subtitle = "La zona comprende los municipios de: Apodaca, Cadereyta Jiménez, El Carmen, García, San Pedro Garza García, General Escobedo, Guadalupe, Juárez, Monterrey, Salinas Victoria, San Nicolás de los Garza, Santa Catarina y Santiago",
y = "Porcentaje de fecundidad")+
theme(plot.title = element_text(face = "bold",
size = 17),
plot.subtitle = element_text(size = 8),
axis.title = element_text(face = "bold"),
axis.text = element_text(face = "bold"))+
scale_y_continuous(breaks = seq(from = 0, to = 85, by = 5))
# EJERCICIO 13 ------------------------------------------------------------
celulares = indicadores_estatales %>%
filter(no == 98) %>%
filter(cve_ent != "00") %>%
filter(cve_ent != "99") %>%
filter(cve_ent != "33") %>%
filter(cve_ent != "34") %>%
filter(year %in% c(2000, 2005, 2010, 2015, 2020)) #se queda solamente con estos valores de años
tc10 = left_join(celulares, cat_edos, by = "cve_ent")
celulares_ancho = tc10 %>%
pivot_wider(names_from = year, values_from = valor) #crea una tabla en formato ancho
# EJERCICIO 14 ------------------------------------------------------------
celulares_largo = celulares_ancho %>%
pivot_longer(cols = c("2000", "2005", "2010", "2015", "2020"), #regresa la tabla a formato largo indicando que columnas se vuelven filas y con que datos
names_to = "year",
values_to = "valor")
celulares_largo = celulares_largo %>%
mutate(year = as.numeric(year)) #convierte los valores de año a numericos
# EJERCICIO 15 ------------------------------------------------------------
lluvia = indicadores_estatales %>%
filter(no == 950) %>%
filter(cve_ent == "26") #se queda solamente con esta entidad (Sonora)
residuos = indicadores_estatales %>%
filter(no == 564) %>%
filter(cve_ent == "26")
incendios = indicadores_estatales %>%
filter(no == 628) %>%
filter(cve_ent == "26")
ambiental = bind_rows(lluvia, residuos, incendios) #une las 3 tablas diferentes que creamos una abajo de la otra
ambiental = left_join(ambiental, metadatos_estatales, by = "no")
grafica_ambiental = ambiental %>%
ggplot(aes(x = year,
y = valor))+
geom_line(color = "orange3")+
facet_wrap(~indicador, scales = "free_y")+ #indica que cada indicador sea su propia gráfica y ajusta el eje de las y para cada uno
theme_minimal()+
labs(title = "Dashboard ambiental de Sonora",
x = "Año",
y = "Valor")+
theme(plot.title = element_text(face = "bold.italic",
size = 20),
axis.text = element_text(face = "bold",
color = "black"),
axis.title = element_text(face = "bold"))
# EJERCICIO 16 ------------------------------------------------------------
rappi = read.csv("datos_problemario/database.csv") #cargamos la nueva base de datos
rappicount = rappi %>%
count(CATEGORIA_3) #contamos cuantas veces se repite cada categoria de aceite
rappi %>%
distinct(ANO_MES) #nos indica cuantas categorias de la columna ANO_MES hay
rappicount %>%
ggplot(aes(x = CATEGORIA_3,
y = n/1e2))+ #convierte la notación científica en un número más pequeño y legible
geom_col(fill = "lightskyblue")+ #indica que es una gráfica de barras y que estarán coloreadas del color que indique
theme_minimal()+ #quita el fondo gris y lo deja más limpio
labs(title = "Ventas de cada tipo de aceite mediante la plataforma de Rappi en 2023",
subtitle = "Datos sacados de: https://github.com/rappiinc/Rappi_Data_Analytics",
caption = "Paula Reinah Aponte",
x = "Categoría de aceite vendido",
y = "Cantidad de unidades vendidas / 100")+
theme(plot.title = element_text(face = "bold.italic",
size = 17),             #elementos meramente estéticos del título, subtítulo, caption y ejes
plot.subtitle = element_text(face = "bold"),
axis.text = element_text(face = "bold",
color = "black"),
axis.title = element_text(face = "bold"),
plot.caption = element_text(face = "bold.italic",
color = "black"))+
scale_y_continuous(breaks = seq(from = 0, to = 1400, by = 200)) #hace que el eje de la y sea más amplio y sea más sencillo de ver las métricas
ggsave("gráfica_rappi.jpeg",
width = 10, #guarda la gráfica en la carpeta de la computadora con ese nombre, formato y medidas
height = 8)
