library(stringi)
estado_sel <- "Puebla"
# 1. Proceso optimizado: Filtrar los 3 números de indicador de una vez
ambiental <- indicadores_estatales %>%
filter(no %in% c(564, 950, 628)) %>%
left_join(cat_edos, by = "cve_ent") %>%
filter(entidad == estado_sel) %>%
left_join(metadatos_estatales, by = "no") %>%
# Limpiamos el nombre del indicador para que no se amontone
mutate(indicador_limpio = str_wrap(indicador, width = 30))
# 2. Gráfica mejorada
grafica_ambiental <- ggplot(ambiental, aes(x = year, y = valor)) +
geom_line(color = "steelblue", size = 0.8) + # Línea más estética
geom_point(color = "darkblue", size = 1) +    # Puntos para marcar años con datos
facet_wrap(~indicador_limpio,
scales = "free_y",
ncol = 3) + # Forzamos 3 columnas para que se vea como la tuya pero legible
labs(
title = paste("Evolución de Indicadores Ambientales:", estado_sel),
subtitle = "Periodo disponible por indicador",
x = "Año",
y = "Valor de la unidad correspondiente",
caption = "Fuente: Elaboración propia con datos del repositorio estatal"
) +
theme_minimal() +
theme(
strip.text = element_text(face = "bold", size = 9), # Títulos de facetas en negrita
panel.spacing = unit(1.5, "lines"),               # Más espacio entre gráficas
axis.text.x = element_text(angle = 45, hjust = 1) # Inclinamos años si se amontonan
)
grafica_ambiental
datos <- read.csv("Datos/1-19.csv", stringsAsFactors = FALSE)
datos <- read.csv("datos_problemario/1-19.csv", stringsAsFactors = FALSE)
datos$Member <- ifelse(datos$Member == ".", NA, datos$Member)
datos$Member <- gsub(",", "", datos$Member)
datos$Member <- as.numeric(datos$Member)
datos$Year <- as.numeric(datos$Year)
datos <- datos %>%
filter(Chamber == "House")
datos_resumen <- datos %>%
group_by(Year, Party) %>%
summarise(Member = sum(Member, na.rm = TRUE), .groups = "drop")
datos_resumen <- datos_resumen %>%
arrange(Year)
ggplot(datos_resumen, aes(x = Year, y = Member, color = Party, group = Party)) +
geom_line(size = 1.2) +
geom_point() +
scale_color_manual(
values = c("D" = "#2E86C1", "R" = "#E74C3C"))+
labs(
title = "Número de mujeres electas a la Cámara de Representantes de EE.UU. por partido",
subtitle = "El partido Democrata a postulado a más mujeres a la cámara que el partido Republicano",
x = "Año",
y = "Número de mujeres electas",
color = "Partido",
caption ="Fuente: Congressional Quarterly's Guide to U.S. Elections")+
theme_economist_white()+
theme(plot.title = element_text(color = "black",
hjust = 0,
family = "Arial",
face = "bold",
size = 20,
),
plot.subtitle = element_text(color = "gray30",
hjust = 0.5,
family = "Arial",
face = "bold",
size = 15,
),
plot.caption = element_text(color = "gray30",
hjust = 1,
family = "Arial",
face = "bold",
size = 10
),
axis.text = element_text(size = 10),
)
