"Chiapas"="red",
"Tabasco"="blue",
"Puebla"="brown",
"Nuevo León"="green",
"Sonora"="purple"
)) +
scale_y_continuous() +
labs(
title="Mortalidad por diabetes en México",
subtitle="Fuente: consulta metadatos",
caption="Hecho por: Arturo Valerio",
x="Año",
y="Tasa por 100k"
) +
theme_economist_white()
grafica_diabetes_final
